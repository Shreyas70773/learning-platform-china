# Set these in the Netlify dashboard (Site settings → Environment variables).
# For local development with the backend, copy to `.env.local` and run `netlify dev`.

# Secret for signing login JWTs (use a long random string).
JWT_SECRET=change-me-to-a-long-random-secret

# Gates the admin add-user endpoint (/api/admin/add-user via the x-admin-secret header).
ADMIN_SECRET=change-me-too

# Only used by scripts/add-user.mjs when provisioning users from your machine.
# SITE_URL=https://your-site.netlify.app
